#!/bin/bash

# Helper for the io.github.dicemans.docker-vms Omarchy shell plugin.
#
# The QML panel stays presentational: every docker call, port lookup, and
# client launch lives here so it can be read, tested, and fixed from a
# terminal without touching the shell.
#
#   docker-vm-ctl list [name-filter]   TSV, one line per container
#   docker-vm-ctl start|restart <name>
#   docker-vm-ctl stop <name> [timeout-seconds]
#   docker-vm-ctl remove <name>        delete a container docker will let go
#   docker-vm-ctl connect <name>       RDP session (same as: omarchy-windows-vm launch -k)
#   docker-vm-ctl viewer <name>        web/VNC viewer in the default browser
#
# `list` is the only chatty command; everything else prints a short reason on
# failure and exits non-zero, which is what the panel surfaces as a row error.

set -uo pipefail

# Container ports the dockur images publish. RDP is the interactive session,
# 8006 is the noVNC web viewer QEMU exposes over a websocket.
RDP_CONTAINER_PORT=3389
WEB_CONTAINER_PORT=8006

# dockur's own defaults, used when a container declares neither.
DEFAULT_USER="docker"
DEFAULT_PASS="admin"

# Seconds docker waits for a graceful shutdown before SIGKILL, and seconds we
# wait for a guest to answer on RDP. Both are overridable per call because the
# right value is a property of the workload: a Windows VM needs far longer to
# flush its disk than a web server needs to close its sockets.
DEFAULT_STOP_TIMEOUT=60
DEFAULT_RDP_TIMEOUT=120

# States docker will actually let us act on. Asking docker to start a paused
# container, or to remove one that is still running, fails — offering those
# actions at all was the bug this table removes.
REMOVABLE_STATES="created exited dead"

# Hard caps on everything read from docker. A host with thousands of
# containers, or a container whose name is a megabyte long, must not be able
# to grow this script's memory — or the shell's, which keeps whatever we print
# alive in a long-running process. Every producer below is bounded while it is
# read rather than trimmed afterwards.
MAX_ROWS=200        # containers listed
MAX_BYTES=262144    # bytes accepted from any single docker invocation
MAX_FIELD=512       # characters kept per field
MAX_DIAG=400        # characters of diagnostic text ever printed

# Truncate one field to MAX_FIELD and strip anything that would break the TSV
# contract the panel parses.
clip() {
  local value="${1//[$'\t\n\r']/ }"
  printf '%s' "${value:0:MAX_FIELD}"
}

die() {
  local reason="${1:0:MAX_DIAG}"
  echo "$reason" >&2
  exit 1
}

# A non-fatal notice. stdout still carries a valid, if partial, list; the
# panel shows this as a footnote rather than an error.
notice() {
  echo "${1:0:MAX_DIAG}" >&2
}

require_docker() {
  command -v docker >/dev/null 2>&1 || die "docker-missing"
}

# The one place that decides whether a container is a desktop VM worth
# offering a session button for. Image name is the honest signal: the dockur
# images are named for their guest, and anything else is a plain container.
kind_for() {
  local image="${1,,}"
  case "$image" in
    *windows*) echo "windows" ;;
    *macos*) echo "macos" ;;
    *) echo "container" ;;
  esac
}

# Go-template fragment that resolves one container port to its host port.
#
# HostConfig.PortBindings is asked first because it is what the container was
# created with and survives a stop — docker's `ps` Ports column and
# NetworkSettings.Ports are both empty while a container is down, which would
# hide the connect button on exactly the VMs the user wants to start.
# NetworkSettings is the fallback for `-P`, where the host port is assigned at
# run time and HostConfig carries an empty HostPort.
port_template() {
  local port="$1" fallback
  fallback='{{if $.NetworkSettings.Ports}}{{with index $.NetworkSettings.Ports "'"$port"'/tcp"}}{{(index . 0).HostPort}}{{else}}0{{end}}{{else}}0{{end}}'
  printf '%s' '{{if $.HostConfig.PortBindings}}{{with index $.HostConfig.PortBindings "'"$port"'/tcp"}}{{(index . 0).HostPort}}{{else}}'"$fallback"'{{end}}{{else}}'"$fallback"'{{end}}'
}

# Host port for one container port, or 0. Used by connect/viewer, which act on
# a single container and can afford their own inspect.
bound_port() {
  local name="$1" port="$2" value
  value=$(docker inspect --format "$(port_template "$port")" "$name" 2>/dev/null)
  echo "${value:-0}"
}

# Rank for list ordering: VMs first, plain containers after, each group
# alphabetical. A stable order keeps the panel's keyboard cursor from jumping
# between refreshes.
kind_rank() {
  case "$1" in
    windows) echo 0 ;;
    macos) echo 1 ;;
    *) echo 2 ;;
  esac
}

# Read a docker producer under a hard budget. `head` bounds it from the
# consumer side: once the cap is reached the pipe closes and docker is stopped
# by SIGPIPE, so the full output is never materialized anywhere. The producer's
# own exit status is preserved through PIPESTATUS so a dead daemon is still
# distinguishable from an empty result.
bounded() {
  local rows="$1"; shift
  "$@" 2>/dev/null | head -c "$MAX_BYTES" | head -n "$rows"
  return "${PIPESTATUS[0]}"
}

cmd_list() {
  require_docker
  local filter="${1:-}"

  local meta
  # One extra row is requested so hitting the cap is detectable without a
  # second, unbounded count.
  meta=$(bounded $((MAX_ROWS + 1)) docker ps -a --format '{{.Names}}\t{{.Image}}\t{{.State}}\t{{.Status}}') \
    || die "daemon-unreachable"
  [[ -n $meta ]] || return 0

  local truncated=0
  if (( $(printf '%s\n' "$meta" | wc -l) > MAX_ROWS )); then
    truncated=1
    meta=$(printf '%s\n' "$meta" | head -n "$MAX_ROWS")
  fi

  # One inspect for every container, so port lookup costs a single call no
  # matter how many rows the panel shows — bounded the same way.
  local ids ports_raw
  ids=$(bounded "$MAX_ROWS" docker ps -aq)
  declare -A rdp_of web_of
  if [[ -n $ids ]]; then
    ports_raw=$(bounded "$MAX_ROWS" docker inspect \
      --format "{{.Name}}{{\"\t\"}}$(port_template "$RDP_CONTAINER_PORT"){{\"\t\"}}$(port_template "$WEB_CONTAINER_PORT")" \
      $ids)
    local pname prdp pweb
    while IFS=$'\t' read -r pname prdp pweb; do
      [[ -n $pname && -n $prdp ]] || continue
      pname="${pname#/}"
      rdp_of["${pname:0:MAX_FIELD}"]="${prdp:0:16}"
      web_of["${pname:0:MAX_FIELD}"]="${pweb:0:16}"
    done <<<"$ports_raw"
  fi

  local name image state status kind
  while IFS=$'\t' read -r name image state status; do
    # A byte-capped read can end mid-line; a row without all four fields is
    # dropped rather than guessed at.
    [[ -n $name && -n $image && -n $state ]] || continue
    if [[ -n $filter && $name != *"$filter"* ]]; then continue; fi
    kind=$(kind_for "$image")
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$(kind_rank "$kind")" "$(clip "$name")" "$(clip "$image")" "$(clip "$state")" \
      "$(clip "$status")" "$kind" \
      "${rdp_of[${name:0:MAX_FIELD}]:-0}" "${web_of[${name:0:MAX_FIELD}]:-0}"
  done <<<"$meta" | sort -t$'\t' -k1,1n -k2,2 | cut -f2-

  (( truncated == 0 )) || notice "list-truncated"
}

container_exists() {
  docker inspect "$1" >/dev/null 2>&1
}

container_state() {
  docker inspect --format '{{.State.Status}}' "$1" 2>/dev/null
}

# Read one variable out of a container's environment, falling back to a
# default. Values may contain '=', so only the first one splits the pair.
container_env() {
  local name="$1" key="$2" fallback="$3" value
  value=$(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$name" 2>/dev/null \
    | sed -n "s/^${key}=//p" | head -1)
  echo "${value:-$fallback}"
}

# Detach GUI clients from the shell process. uwsm gives them their own
# systemd scope, exactly as the Windows .desktop entry does; setsid is the
# fallback for sessions without uwsm.
launch_detached() {
  if command -v uwsm-app >/dev/null 2>&1; then
    uwsm-app -- "$@" >/dev/null 2>&1 &
  else
    setsid "$@" >/dev/null 2>&1 &
  fi
  disown 2>/dev/null
}

# Run a docker command and, when it fails, surface docker's own first line
# instead of a generic code. docker almost always says exactly what went wrong
# — "port is already allocated", "no such image", "device or resource busy" —
# and swallowing that was turning every failure into an unactionable
# "Could not start the container".
docker_do() {
  local fallback="$1"
  shift
  local err
  if err=$("$@" 2>&1 >/dev/null); then
    return 0
  fi
  err=$(printf '%s\n' "$err" | head -1)
  die "${err:-$fallback}"
}

cmd_lifecycle() {
  local action="$1" name="$2" timeout="${3:-}"
  require_docker
  [[ -n $name ]] || die "no-container"
  container_exists "$name" || die "no-such-container"

  if [[ $action == "stop" ]]; then
    # Without -t docker allows 10 seconds and then SIGKILLs. That is a hard
    # power cut for a Windows VM mid-flush, so the caller sets the budget.
    [[ $timeout =~ ^[0-9]+$ ]] || timeout=$DEFAULT_STOP_TIMEOUT
    docker_do "stop-failed" docker stop -t "$timeout" "$name"
  else
    docker_do "${action}-failed" docker "$action" "$name"
  fi
}

# Wait for the guest to answer on RDP. A cold Windows VM needs ~20-40s, so the
# ceiling is generous; each probe is cheap and the loop exits the moment the
# port answers.
wait_for_rdp() {
  local port="$1" budget="${2:-$DEFAULT_RDP_TIMEOUT}" deadline
  deadline=$((SECONDS + budget))
  while ((SECONDS < deadline)); do
    if timeout 2 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/$port" 2>/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

# Deleting is the one action that cannot be undone from the panel, so it is
# deliberately narrow: only a stopped container, and never `-f` or `-v`. The
# image and any volume — including the bind mount holding a VM's disk — are
# left exactly where they are, so the container can be recreated over them.
cmd_remove() {
  local name="$1"
  require_docker
  [[ -n $name ]] || die "no-container"
  container_exists "$name" || die "no-such-container"
  local state
  state=$(container_state "$name")
  if [[ " $REMOVABLE_STATES " != *" $state "* ]]; then
    # A paused or restarting container reached this point under the old
    # `!= running` test and then failed inside docker, after the destructive
    # confirmation had already been shown.
    die "not-removable:$state"
  fi
  docker_do "remove-failed" docker rm "$name"
}

cmd_connect() {
  local name="$1" rdp_timeout="${2:-}"
  [[ $rdp_timeout =~ ^[0-9]+$ ]] || rdp_timeout=$DEFAULT_RDP_TIMEOUT
  require_docker
  [[ -n $name ]] || die "no-container"
  container_exists "$name" || die "no-such-container"

  # Containers omarchy installed keep their own launcher, which already knows
  # the compose file, the credentials, and the display scaling. -k matches the
  # panel's contract: connecting must never stop the VM on disconnect.
  if [[ $name == "omarchy-windows" ]] && command -v omarchy-windows-vm >/dev/null 2>&1; then
    launch_detached omarchy-windows-vm launch -k
    return 0
  fi

  command -v xfreerdp3 >/dev/null 2>&1 || die "xfreerdp3-missing"

  local port
  port=$(bound_port "$name" "$RDP_CONTAINER_PORT")
  [[ $port != "0" ]] || die "no-rdp-port"

  if [[ $(container_state "$name") != "running" ]]; then
    docker start "$name" >/dev/null 2>&1 || die "start-failed"
  fi

  local user pass
  user=$(container_env "$name" USERNAME "$DEFAULT_USER")
  pass=$(container_env "$name" PASSWORD "$DEFAULT_PASS")

  wait_for_rdp "$port" "$rdp_timeout" || { unset pass; die "rdp-timeout"; }

  local -a args=(
    "/u:${user:0:MAX_FIELD}"
    "/p:$pass"
    "/v:127.0.0.1:$port"
    "-grab-keyboard" "/sound" "/microphone" "/clipboard" "/cert:ignore"
    "/title:$(clip "$name")"
    "/dynamic-resolution" "/gfx:AVC444"
    "/floatbar:sticky:off,default:visible,show:fullscreen"
  )

  # The password must never reach the argument vector: /proc/<pid>/cmdline is
  # world-readable, so `/p:secret` on the command line hands the credential to
  # every other user on the machine. /args-from:stdin makes xfreerdp3 read its
  # entire command line from the pipe below — one argument per line — leaving
  # only the flag itself visible in the process list.
  #
  # This is also why the client is detached with setsid rather than uwsm here:
  # uwsm hands the launch to a daemon, and the pipe would not reach the process
  # that has to read from it.
  printf '%s\n' "${args[@]}" | setsid xfreerdp3 /args-from:stdin >/dev/null 2>&1 &
  disown 2>/dev/null

  # Drop the secret as soon as the pipe owns it. The array is cleared too: it
  # holds the same string.
  unset pass args
}

cmd_viewer() {
  local name="$1"
  require_docker
  [[ -n $name ]] || die "no-container"
  container_exists "$name" || die "no-such-container"

  local port
  port=$(bound_port "$name" "$WEB_CONTAINER_PORT")
  [[ $port != "0" ]] || die "no-web-port"

  if [[ $(container_state "$name") != "running" ]]; then
    docker start "$name" >/dev/null 2>&1 || die "start-failed"
  fi

  local url="http://127.0.0.1:$port"
  if command -v omarchy-launch-browser >/dev/null 2>&1; then
    launch_detached omarchy-launch-browser "$url"
  else
    launch_detached xdg-open "$url"
  fi
}

case "${1:-}" in
  list) cmd_list "${2:-}" ;;
  start | stop | restart) cmd_lifecycle "$1" "${2:-}" "${3:-}" ;;
  remove) cmd_remove "${2:-}" ;;
  connect) cmd_connect "${2:-}" "${3:-}" ;;
  viewer) cmd_viewer "${2:-}" ;;
  *)
    echo "usage: docker-vm-ctl list [filter] | start|restart|remove <name> | stop <name> [timeout] | connect <name> [timeout] | viewer <name>" >&2
    exit 2
    ;;
esac
